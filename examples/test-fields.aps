-- TEST-FIELDS.APS
-- August 2026
-- This tests that fields on objects can be set at different times.

with "tiny";
module TEST_FIELDS[T :: var TINY[]] extends T begin
	phylum Object;
	constructor con() : Object;
	type Ref := remote Object;
	
	attribute Wood.s : Integer;
	attribute Wood.ri : Ref;
	attribute Wood.rs : Ref;
	attribute Root.r : Integer;

	attribute Object.init : Integer;
	collection attribute Object.later : Integer :> 0, (+);
	attribute Object.middle : Integer;
	collection attribute Object.later2 : Integer :> 0, (+);

	pragma inherited(ri);
	pragma synthesized(s, rs, r);

	match ?self=root(?t) begin
		t.ri := nil;
		if t.rs = nil then
			self.r := t.s;
		else
			t.rs.later :> 0;
			t.rs.later2 :> 1;
			self.r := t.s + t.rs.middle;
		endif;
	end;

	match ?self=branch(?x, ?y) begin
		x.ri := self.ri;
		y.ri := x.rs;
		self.rs := y.rs;
		self.s := x.s + y.s;
	end;

	match ?l=leaf(?n) begin
		o : Object := con();
		o.init := n;
		if l.ri = nil then
			o.middle := o.init + o.later; 
		else
			l.ri.later :> n;
			o.middle := o.init + o.later + l.ri.init;
			l.ri.later2 :> o.middle;
		endif;
		l.rs := o;
		l.s := o.later2;
	end;
end;
