with "tiny";
-- Regression test of all sequence case patterns and their combinations.
module TEST_CASE_PATTERNS[T :: var TINY[]] extends T begin

  type Leaves := SET[Integer];

  var collection all_leaves : Leaves;

  attribute Root.first : Integer;
  attribute Root.each : Integer;
  attribute Root.last : Integer;
  attribute Root.first_last : Integer;
  attribute Root.first_each : Integer;
  attribute Root.each_last : Integer;
  attribute Root.first_each_last : Integer;
  attribute Root.separated_span : Integer;
  attribute Root.adjacent_span : Integer;
  attribute Root.endpoint_middles : Integer;

  pragma synthesized(first, each, last, first_last, first_each, each_last,
                     first_each_last, separated_span, adjacent_span,
                     endpoint_middles);

  match ?r=root(?w) begin
    case all_leaves begin
      match {?first_leaf,...} begin
        r.first := first_leaf;
      end;
    else
      r.first := 0;
    end;

    case all_leaves begin
      match {...,?leaf,...} begin
        r.each := leaf;
      end;
    else
      r.each := 0;
    end;

    case all_leaves begin
      match {...,?last_leaf} begin
        r.last := last_leaf;
      end;
    else
      r.last := 0;
    end;

    case all_leaves begin
      match {?first_leaf,...,?last_leaf} begin
        r.first_last := first_leaf * 100 + last_leaf;
      end;
    else
      r.first_last := 0;
    end;

    case all_leaves begin
      match {?first1,?first2,...} begin
        r.first_each := 100000 + first1 * 100 + first2;
      end;
    else
      r.first_each := 0;
    end;

    case all_leaves begin
      match {...,?last1,?last2} begin
        r.each_last := 200000 + last1 * 100 + last2;
      end;
    else
      r.each_last := 0;
    end;

    case all_leaves begin
      match {...,?left,...,?right,...} begin
        r.separated_span := right - left;
      end;
    else
      r.separated_span := 0;
    end;

    case all_leaves begin
      match {...,?left,?right,...} begin
        r.adjacent_span := right - left;
      end;
    else
      r.adjacent_span := 0;
    end;

    case all_leaves begin
      match {?first_leaf,...,?left,?right,...,?last_leaf} begin
        r.endpoint_middles := left * 100 + right;
      end;
    else
      r.endpoint_middles := 0;
    end;

    case all_leaves begin
      match {?first1,?first2,...,?last1,?last2} begin
        r.first_each_last := first1 * 1000000 + first2 * 10000 +
                             last1 * 100 + last2;
      end;
    else
      r.first_each_last := 0;
    end;
  end;

  match ?w=branch(?x,?y) begin
  end;

  match ?l=leaf(?x) begin
    if x >= 0 then
      all_leaves :> {x};
    endif;
  end;

end;
